# =============================================================================
# GuauWoow - Variables de entorno
# =============================================================================
# Copia este archivo a .env (en la raíz del repo) y completa los valores:
#   cp .env.example .env && chmod 600 .env
# Docker Compose lo lee automáticamente. Una variable vacía cuenta como "no definida":
# se usa el valor por defecto del compose (${VAR:-defecto}) o de backend/app/config.py.
#
# Cada integración externa es OPCIONAL salvo las marcadas [OBLIGATORIA EN PRODUCCIÓN]:
# si su variable está vacía, la función se desactiva con un mensaje claro (503) o, solo en
# ENVIRONMENT=development, usa una alternativa de prueba documentada.
#
# Producción: el backend se NIEGA a arrancar y lista en un solo mensaje todos los problemas
# (docker compose -f docker-compose.production.yml logs backend) si:
#   - SECRET_KEY es la de desarrollo o tiene menos de 32 caracteres; ALGORITHM no es HS256/384/512
#   - PUBLIC_BASE_URL falta, no es https:// o apunta a localhost/127.0.0.1
#   - CORS_ORIGINS está vacío, es "*" o tiene http:// o localhost; CORS_ORIGIN_REGEX permite trycloudflare
#   - la contraseña de PostgreSQL es "patitasfind"
#   - SMS_PROVIDER=dev, o REQUIRE_PHONE_VERIFICATION=true sin llaves de SMS
#   - falta SMTP_HOST o SMTP_FROM (sin correo no hay "olvidé mi contraseña" ni verificación de correo)
#   - MERCADOPAGO_ACCESS_TOKEN sin MERCADOPAGO_WEBHOOK_SECRET
#   - WhatsApp activo sin WHATSAPP_APP_SECRET o con el WHATSAPP_VERIFY_TOKEN de desarrollo
#   - SHOP_ENABLED=true sin Mercado Pago configurado (o sin MERCADOPAGO_APP_ID / MERCADOPAGO_CLIENT_SECRET)
#   - PAC_PROVIDER definido sin PAC_USER, PAC_PASSWORD o los datos EMISOR_*
#   - comisión de GuauWoow mayor a 0 (tienda activa o donativos) sin PAC ni datos EMISOR_* completos
#   - comisión mayor a 0 sin PLATFORM_TAX_REGIME_READY=true (régimen de plataformas confirmado por el contador)
#   - FB_GROUPS_ENABLED=true sin FB_GROUPS_LEGAL_OPINION_REF (opinión legal escrita)
#   - DONATION_MAX_MXN / DONATION_DAILY_MAX_MXN en 0 o iguales o mayores al umbral de identificación (LFPIORPI)
#   - FOUND_DOG_HOLD_DAYS menor a 1
#   - falta PRIVATE_FILES_KEY (o no es el base64 de 32 bytes) o MFA_REQUIRED_FOR_ADMINS=false
#
# Variables marcadas [avanzada]: tienen un buen valor por defecto; cámbialas solo si sabes por qué.
# Ojo: Docker Compose solo pasa al backend las variables listadas en "x-backend-env" de cada
# docker-compose*.yml. Si agregas una que no esté ahí, súmala también al compose.

# ---------------------------------------------------------------------------
# Entorno y dominio
# ---------------------------------------------------------------------------
# development | production   (docker-compose.production.yml fija production por su cuenta)
#  - development: login demo, OTP/pagos/correos simulados si faltan llaves, tienda activa.
#  - production: sin simulaciones (503 cuando falta una integración), validación estricta (arriba).
ENVIRONMENT=development

# [OBLIGATORIA EN PRODUCCIÓN] Dominio público SIN https:// ni "/" (p. ej. guauwoow.com).
# Lo usan Nginx y los certificados, y de él salen los valores por defecto de PUBLIC_BASE_URL y CORS_ORIGINS.
# DNS: registros A (y AAAA si hay IPv6) de DOMAIN y www.DOMAIN apuntando al servidor.
DOMAIN=
# Modo de Nginx en producción: https (normal) | http-only (solo para emitir el primer certificado)
NGINX_MODE=https
# none (sin proxy delante) | cloudflare (DNS con la nube naranja de Cloudflare: la IP real del
# cliente se toma de CF-Connecting-IP para los límites de peticiones)
NGINX_REAL_IP=none

# URL pública desde la que la gente abre GuauWoow, SIN "/" al final. DÉJALA VACÍA:
#  - producción: docker-compose.production.yml usa https://$DOMAIN
#  - desarrollo: docker-compose.yml usa http://localhost:8082
# Defínela solo si la URL pública es otra (p. ej. un túnel https://xxxx.trycloudflare.com en desarrollo).
# Se usa en: enlaces de verificación de correo y de "restablecer contraseña", back_urls y webhook
# de Mercado Pago, redirección de Google y enlaces que manda el bot de WhatsApp.
PUBLIC_BASE_URL=

# Login de demostración (botón "Entrar en modo demo"). Vacío = activo solo en development.
# En production siempre está desactivado.
ALLOW_DEMO_LOGIN=

# Los pone backend/scripts/deploy.sh en cada despliegue (no los edites a mano):
#   BACKEND_TAG = etiqueta de la imagen (sha del commit; rollback.sh vuelve a una anterior)
#   GIT_SHA     = commit dentro de la imagen; Sentry lo usa como release "patitasfind@<sha>"
# BACKEND_TAG=
# GIT_SHA=

# ---------------------------------------------------------------------------
# Seguridad y sesiones (JWT)
# ---------------------------------------------------------------------------
# [OBLIGATORIA EN PRODUCCIÓN] Mínimo 32 caracteres. Vacío en desarrollo = clave de desarrollo.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Cambiarla cierra TODAS las sesiones abiertas.
SECRET_KEY=
# [avanzada] HS256 | HS384 | HS512
ALGORITHM=HS256
# Duración de la sesión en minutos (10080 = 7 días)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Sesiones de admin y superadmin, en minutos (480 = 8 horas)
ADMIN_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# Seguridad: verificación en dos pasos, cifrado en reposo y conservación (L-seguridad)
# ---------------------------------------------------------------------------
# Verificación en dos pasos (app de autenticación, TOTP) para admin y superadmin.
# Vacía = obligatoria en todo entorno salvo development. En producción no puede ser false.
MFA_REQUIRED_FOR_ADMINS=
# Nombre que verá el personal en su app de autenticación
MFA_ISSUER=GuauWoow
# [OBLIGATORIA EN PRODUCCIÓN] Llave AES-256 (base64 de 32 bytes) que cifra uploads/private/* (INE, actas,
# cédulas, constancias fiscales, CFDI) y los datos fiscales de la base. Genérala con:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"   (o: openssl rand -base64 32)
# o, en desarrollo: docker compose exec backend python -m app.cli generate-private-key
# Guarda una copia FUERA del servidor: sin ella no se pueden leer los documentos ni los respaldos.
# Al definirla por primera vez corre: python -m app.cli encrypt-private-files
PRIVATE_FILES_KEY=
# Al rotar la llave: pon la anterior aquí (separadas por comas), la nueva en PRIVATE_FILES_KEY y corre
#   python -m app.cli encrypt-private-files --rotate ; después puedes quitarla.
PRIVATE_FILES_OLD_KEYS=
# false pausa la purga diaria de la tabla de conservación (p. ej. durante una verificación de la autoridad).
# Un incidente abierto con «congelar purgas» también la pausa sin tocar esto.
RETENTION_PURGE_ENABLED=true

# ---------------------------------------------------------------------------
# CORS (orígenes que pueden llamar a la API desde el navegador)
# ---------------------------------------------------------------------------
# Lista separada por comas. DÉJALA VACÍA:
#  - producción: docker-compose.production.yml usa https://$DOMAIN (solo https:// y nunca localhost)
#  - desarrollo: se permiten los puertos locales habituales (8080-8082, 3000, 5500)
# Defínela solo para agregar orígenes, p. ej. CORS_ORIGINS=https://guauwoow.com,https://www.guauwoow.com
CORS_ORIGINS=
# Regex adicional. Vacío = en development permite túneles *.trycloudflare.com; en production ninguno.
CORS_ORIGIN_REGEX=

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=patitasfind
# [OBLIGATORIA EN PRODUCCIÓN] Contraseña larga SIN caracteres especiales de URL (@ : / ?):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacía en desarrollo = "patitasfind". docker-compose.production.yml arma DATABASE_URL con ella.
POSTGRES_PASSWORD=
POSTGRES_DB=patitasfind
# Solo desarrollo: puerto del host para PostgreSQL (docker-compose.yml) y URL completa si corres
# el backend fuera de Docker. En producción DATABASE_URL se arma con POSTGRES_* (se ignora esta).
POSTGRES_HOST_PORT=5433
DATABASE_URL=
# [avanzada] Pool de conexiones POR PROCESO (cuenta en backend/app/database.py):
# WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) + CELERY_CONCURRENCY x (DB_WORKER_POOL_SIZE +
# DB_WORKER_MAX_OVERFLOW) debe quedar muy por debajo de max_connections=150.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Segundos esperando una conexión libre antes de responder error
DB_POOL_TIMEOUT=10
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=2
# [avanzada] Memoria de PostgreSQL. 4 vCPU / 8 GB: 1GB y 3GB. 8 vCPU / 16 GB: 4GB y 10GB.
# Cambiarlas reinicia PostgreSQL (hazlo en una ventana de mantenimiento).
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
# Migraciones de Alembic al arrancar el backend. En producción déjalo en false: deploy.sh migra UNA vez
# antes de cambiar contenedores (y una imagen anterior, tras rollback.sh, no intentaría "migrar" una base
# más nueva). En desarrollo docker-compose.yml lo fija en true.
RUN_MIGRATIONS=false

# ---------------------------------------------------------------------------
# Capacidad (producción; ver docs/operacion.md)
# ---------------------------------------------------------------------------
# Procesos de Uvicorn del backend. 4 vCPU / 8 GB: 4. 8 vCPU / 16 GB: 8.
WEB_CONCURRENCY=4
# Procesos del worker de Celery (bot de WhatsApp, IA, alertas, pagos). 4 vCPU: 4. 8 vCPU: 8.
CELERY_CONCURRENCY=4
# Memoria máxima de Redis (al llenarse solo se desalojan claves con caducidad; las colas no se pierden)
REDIS_MAXMEMORY=512mb

# ---------------------------------------------------------------------------
# Redis (Celery, chat en tiempo real entre workers, caché, límites)
# ---------------------------------------------------------------------------
# Con REDIS_URL las tareas pesadas van a Celery y el chat funciona con varios workers.
# Sin REDIS_URL todo corre dentro del proceso (BackgroundTasks de FastAPI).
REDIS_URL=redis://redis:6379/0
# Vacío = Celery activo si hay REDIS_URL. false = tareas en proceso aunque haya Redis.
USE_CELERY=
# [avanzada] Segundos de caché: general, listados públicos sin sesión y coincidencias de un reporte
CACHE_TTL_SECONDS=300
LIST_CACHE_TTL_SECONDS=60
MATCHES_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Archivos subidos
# ---------------------------------------------------------------------------
# Carpeta relativa al directorio del backend (en Docker: /app/uploads). Los documentos de refugios
# van a uploads/private/, que nunca se sirve en público.
UPLOAD_DIR=uploads
# Tamaño máximo por archivo (MB) y fotos por usuario al día (los admins no tienen límite)
MAX_UPLOAD_MB=10
UPLOAD_DAILY_QUOTA=60
# [avanzada] Hosts de los que el servidor puede descargar fotos (WhatsApp/Facebook); "*." = subdominios.
# Las fotos de publicaciones de grupos de Facebook (scontent-*.fbcdn.net, *.fbsbx.com) siempre se permiten.
REMOTE_MEDIA_HOSTS=graph.facebook.com,lookaside.fbsbx.com,*.fbcdn.net,*.fbsbx.com

# ---------------------------------------------------------------------------
# Tienda solidaria y soporte
# ---------------------------------------------------------------------------
# Vacío = tienda activa en development y APAGADA en production. true la enciende en producción
# (exige Mercado Pago). Con la tienda apagada, productos/pedidos/pago responden 404 y la app oculta
# la tienda; los donativos a refugios siguen funcionando.
SHOP_ENABLED=
# Contacto que muestra la app en Perfil -> Ayuda (usa el mismo correo que CORREO_DE_CONTACTO de
# app/legal/datos-legales.json). WhatsApp con lada internacional, p. ej. +525512345678.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# Domicilio físico y teléfono del operador para el comprobante de compra (LFPC art. 76 Bis). La razón social y el
# RFC salen de EMISOR_NOMBRE y EMISOR_RFC. Deben coincidir con DOMICILIO FISCAL y TELÉFONO de datos-legales.json.
OPERATOR_ADDRESS=
OPERATOR_PHONE=

# ---------------------------------------------------------------------------
# Pagos: Mercado Pago Checkout Pro (México, MXN) - tienda y donativos
# ---------------------------------------------------------------------------
# Dónde obtenerlo: https://www.mercadopago.com.mx/developers/panel/app
#   Crea una aplicación > "Credenciales de producción" (o de prueba) > Access Token.
# Webhook: en la app de Mercado Pago > Webhooks > Configurar notificaciones (modo productivo):
#   URL: https://DOMAIN/payments/mercadopago/webhook   Evento: Pagos
#   y copia la "Clave secreta" en MERCADOPAGO_WEBHOOK_SECRET (valida la firma x-signature).
# Sin token: en development los pedidos/donaciones se aprueban de forma simulada; en production 503.
MERCADOPAGO_ACCESS_TOKEN=
# [OBLIGATORIA EN PRODUCCIÓN si hay MERCADOPAGO_ACCESS_TOKEN]
MERCADOPAGO_WEBHOOK_SECRET=
# [avanzada] Moneda y minutos que se aparta el inventario y dura el link de pago
CURRENCY=MXN
CHECKOUT_EXPIRATION_MINUTES=60

# --- Mercado Pago Marketplace (split 1:1) ---
# Cada refugio cobra con SU cuenta de Mercado Pago (la vincula desde "Mi tienda" con OAuth) y GuauWoow
# solo recibe su comisión (marketplace_fee): la plataforma no custodia dinero de terceros.
# Dónde obtenerlo: https://www.mercadopago.com.mx/developers/panel/app > Crear aplicación (pagos en línea,
#   modelo de integración "Marketplace") > Credenciales de producción: "Client ID" (MERCADOPAGO_APP_ID) y
#   "Client Secret" (MERCADOPAGO_CLIENT_SECRET). En "Editar aplicación" registra como URL de redireccionamiento
#   EXACTA (misma que usa el backend):   {PUBLIC_BASE_URL}/payments/mercadopago/oauth/callback
#   Usa el Access Token y la clave del webhook de ESTA misma aplicación en las dos variables de arriba.
#   Pide a Mercado Pago por escrito la aprobación del modelo marketplace para donativos (gap-custodia-06).
# [OBLIGATORIA EN PRODUCCIÓN si SHOP_ENABLED=true] client_id y client_secret de esa aplicación
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# Comisión de GuauWoow por venta, % del total con IVA incluido. Por defecto 0 (premisa de la plataforma:
# tarifas.html). Debe coincidir con COMISION_TIENDA de app/legal/datos-legales.json.
# En producción, comisión > 0 exige PLATFORM_TAX_REGIME_READY=true y el PAC (PAC_* y EMISOR_*): cobrar comisión
# obliga a emitir cada mes el CFDI de comisión y el de retenciones. Con 0 % no se retiene ISR ni IVA.
MERCADOPAGO_MARKETPLACE_FEE_PERCENT=0
# Comisión sobre donativos (%). La investigación recomienda 0. Debe coincidir con COMISION_DONATIVOS.
MERCADOPAGO_DONATION_FEE_PERCENT=0
# [avanzada] true = los donativos a refugios SIN Mercado Pago vinculado se cobran con la cuenta de la
# plataforma (flujo anterior). Vacío => true solo en development; en producción solo si lo defines.
DONATIONS_FALLBACK_TO_PLATFORM_ACCOUNT=
# true solo cuando tu contador confirme el régimen de plataformas de intermediación (VERIFICAR_REGIMEN_PLATAFORMAS).
# Sin esto, en producción el backend no arranca con comisión > 0.
PLATFORM_TAX_REGIME_READY=false

# --- Donativos: topes y ley antilavado (donativos.html §8, prevencion-lavado.html) ---
# Tope por donativo y tope diario por cuenta (MXN). Deben coincidir con TOPE_POR_DONATIVO y
# TOPE_DIARIO_DE_DONATIVOS de datos-legales.json y quedar muy por debajo de 1,605 UMA.
DONATION_MAX_MXN=50000
DONATION_DAILY_MAX_MXN=50000
# [avanzada] UMA diaria vigente (2026: 117.31; cámbiala cada febrero) y umbrales de la LFPIORPI en UMA
# (identificación 1,605 y aviso 3,210, acumulados por donante y refugio en 6 meses: alerta al refugio y al equipo).
UMA_DAILY_MXN=117.31
DONATION_IDENTIFICATION_UMA=1605
DONATION_NOTICE_UMA=3210

# --- Adopción responsable ---
# Días naturales que un perro encontrado espera (con su reporte de «encontrado» activo, microchip revisado y
# aviso a la autoridad) antes de poder publicarse en adopción. Debe coincidir con
# PLAZO_DE_RESGUARDO_DE_PERROS_ENCONTRADOS de datos-legales.json.
FOUND_DOG_HOLD_DAYS=30

# --- Devoluciones de la tienda ---
# [avanzada] Revocación: 5 días HÁBILES desde la entrega (LFPC art. 56). No lo bajes de 5.
RETURN_WINDOW_DAYS=5
# [avanzada] Reclamación por producto defectuoso, que no corresponde o que no llegó (LFPC art. 93: 2 meses)
RETURN_CLAIM_WINDOW_DAYS=60
# [avanzada] Un pedido entregado sin devolución se marca "completado" a los N días
ORDER_AUTO_COMPLETE_DAYS=10
# [avanzada] Días HÁBILES de gracia después del plazo de despacho del refugio (handling_days del producto):
# al vencer el plazo se avisa al refugio y al comprador; al vencer la gracia el pedido se cancela y se
# reembolsa solo (consumidor-ecommerce-13).
ORDER_DISPATCH_GRACE_DAYS=2

# --- Facturación electrónica (CFDI 4.0) y retenciones de plataformas ---
# Retenciones a refugios vendedores (LIF 2026 art. 25 fr. VI y IX; LIVA 18-J fr. II a)):
# ISR = % del ingreso sin IVA; IVA = % del IVA cobrado. Se separan junto con la comisión en el split.
# Tasas 2026 con RFC: ISR 2.5 % e IVA 50 %. Sin RFC serían ISR 20 % (LISR 113-C fr. IV) e IVA 100 %; no se
# configuran porque en producción no se puede vender sin RFC. Revisa las tasas cada diciembre (reforma 2027).
RETENCION_ISR_PERCENT=2.5
RETENCION_IVA_PERCENT=50
# true (por defecto) = también se retiene a personas morales (LIF 2026 art. 25 fr. VI y IX a), como dice la
# investigación fiscal; ponlo en false solo si tu contador confirma que no aplica.
RETENCION_PERSONAS_MORALES=true
# PAC para timbrar los CFDI de comisión y de retenciones que GuauWoow emite a cada refugio (día 3 de cada
# mes). Vacío = no se timbra nada: los CFDI quedan "pendientes de PAC" en el panel de admins.
# Dónde obtenerlo (Facturama): contrata la API de Facturama (https://facturama.mx, cuenta de API, no la de
#   facturación web) y, para pruebas, crea un usuario en el sandbox https://apisandbox.facturama.mx.
#   PAC_USER/PAC_PASSWORD son el usuario y contraseña de esa cuenta (autenticación HTTP Basic). Antes de
#   timbrar en producción sube el CSD (.cer, .key y contraseña) del emisor en Facturama.
PAC_PROVIDER=
PAC_USER=
PAC_PASSWORD=
# true = sandbox de Facturama (sin validez fiscal). Ponlo en false solo con credenciales de producción.
PAC_SANDBOX=true
# Datos del emisor: la persona moral que opera GuauWoow (como en su Constancia de Situación Fiscal)
EMISOR_RFC=
EMISOR_NOMBRE=
EMISOR_REGIMEN=
EMISOR_CP=
CFDI_SERIE=PF

# ---------------------------------------------------------------------------
# Verificación de teléfono por SMS (obligatoria para publicar, adoptar, chatear, pagar…)
# ---------------------------------------------------------------------------
# [OBLIGATORIA EN PRODUCCIÓN] un proveedor con llaves: sin él el backend no arranca.
# GuauWoow genera su propio código de 6 dígitos; el proveedor solo entrega el SMS.
#   smsmasivos (recomendado en México, ~$0.47–0.90 MXN por SMS) | twilio | zernio | dev
#   dev: no envía nada y devuelve el código como "dev_code" (solo ENVIRONMENT=development).
#   En development, si el proveedor elegido no tiene llaves, se usa "dev" automáticamente.
SMS_PROVIDER=smsmasivos
# false = el teléfono es opcional y no se exige verificarlo
REQUIRE_PHONE_VERIFICATION=true
#
# SMS Masivos: https://app.smsmasivos.com.mx  > API > copia tu API key
SMSMASIVOS_API_KEY=
# true = modo sandbox (la API responde OK sin enviar ni cobrar; útil para probar la integración)
SMSMASIVOS_SANDBOX=false
# [avanzada] SMSMASIVOS_URL=https://api.smsmasivos.com.mx/sms/send
#
# Twilio (Messages API; NO Verify): https://console.twilio.com
#   Account SID y Auth Token en la consola; un número con SMS habilitado para México
#   o un Messaging Service (MG...). Más caro (~$0.18 USD por SMS a México).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
#
# Zernio (SMS API: POST https://zernio.com/api/v1/sms/messages): https://docs.zernio.com/platforms/sms/sending
#   ZERNIO_API_KEY: API key de tu cuenta en Zernio (Bearer token)
#   ZERNIO_FROM: Número con SMS habilitado en E.164 (+1..., +52...) o Sender ID de marca (p. ej. GUAUWOOW, 3-11 caracteres)
ZERNIO_API_KEY=
ZERNIO_FROM=
#
# [avanzada; solo desarrollo, no están en docker-compose.production.yml] Reglas del código:
# vence en 10 min, 5 intentos, reenvío cada 60 s, máx. 5 SMS por teléfono y 10 por IP cada hora.
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_PHONE_HOUR=5
# OTP_MAX_SENDS_PER_IP_HOUR=10
# DEFAULT_PHONE_COUNTRY_CODE=52

# ---------------------------------------------------------------------------
# Correo (SMTP): verificación de correo, "olvidé mi contraseña" y alertas
# ---------------------------------------------------------------------------
# [OBLIGATORIA EN PRODUCCIÓN] SMTP_HOST y SMTP_FROM.
# Cualquier proveedor SMTP: Amazon SES, Brevo, Mailgun, SendGrid, Zoho, Google Workspace
# (contraseña de aplicación), etc. Puerto 587 = STARTTLS, 465 = SSL.
# Antes de producción configura SPF, DKIM y DMARC del dominio de SMTP_FROM (README-despliegue.md);
# sin ellos los correos llegan a spam.
# Sin SMTP (solo desarrollo): el enlace se imprime en los logs y se devuelve como "dev_link".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente, p. ej. GuauWoow <no-reply@guauwoow.com>
SMTP_FROM=
# true = STARTTLS (587); con el puerto 465 se usa SSL
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Google OAuth (botón "Continuar con Google")
# ---------------------------------------------------------------------------
# Dónde obtenerlo: https://console.cloud.google.com/apis/credentials
#   Crear credenciales > ID de cliente de OAuth > Aplicación web (pasos en README-despliegue.md).
#   URI de redireccionamiento: https://DOMAIN/auth/google/callback
#   (local: http://localhost:8082/auth/google/callback, pasa por app/server.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: forzar otra URI; vacío = {PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# IA de visión: análisis de fotos (API compatible con OpenAI Chat Completions)
# ---------------------------------------------------------------------------
# Sin AI_API_KEY: la búsqueda por foto funciona solo con similitud visual (hash + color)
# y POST /ai/analyze-photo responde 503 "IA no configurada".
AI_PROVIDER=openai_compatible
AI_API_KEY=
#
# Opción A (por defecto) – Alibaba Cloud Model Studio internacional (Qwen3-VL):
#   Llave: https://modelstudio.console.alibabacloud.com  > API Key (región Singapur/internacional)
#   qwen3-vl-flash : el más barato, suficiente para describir perros.
#   qwen3-vl-plus  : mejor calidad.
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3-vl-flash
#
# Opción B – Z.ai (GLM-4.6V):  https://z.ai/manage-apikey/apikey-list
#   AI_BASE_URL=https://api.z.ai/api/paas/v4
#   AI_MODEL=glm-4.6v-flash   (gratis, con límite de peticiones)  |  glm-4.6v  (de pago, mejor)
#
# JSON opcional que se agrega al cuerpo de la petición (parámetros propios del proveedor), p. ej.
#   Qwen3 sin razonamiento:  AI_EXTRA_BODY={"enable_thinking": false}
#   GLM sin razonamiento:    AI_EXTRA_BODY={"thinking": {"type": "disabled"}}
AI_EXTRA_BODY=
# Segundos por llamada (1 reintento en 429/5xx)
AI_TIMEOUT_SECONDS=20
# Puntaje mínimo (0-100) para avisar "¡Posible coincidencia!" a los dueños de reportes
MATCH_SCORE_THRESHOLD=60
# [avanzada] Límites para cuidar el costo de la IA (al rebasarlos: 429 con mensaje en español)
#   llamadas simultáneas a la IA por proceso | análisis por usuario y hora
AI_MAX_CONCURRENCY=4
AI_USER_HOURLY_LIMIT=20
#   búsqueda por foto: con sesión por usuario/hora | sin sesión por IP/minuto | sin sesión por IP/día
#   (vacío = 30 al día; sin tope diario en development)
SEARCH_USER_HOURLY_LIMIT=30
SEARCH_ANON_MINUTE_LIMIT=5
SEARCH_ANON_DAILY_LIMIT=
#   GET /lost-reports/{id}/matches por IP y minuto
REPORT_MATCHES_IP_MINUTE_LIMIT=30

# ---------------------------------------------------------------------------
# Reportes de perdidos/encontrados y alertas cercanas
# ---------------------------------------------------------------------------
# Días sin cambios para que un reporte activo pase a "expirado" (el reportero puede renovarlo).
# Si lo cambias, actualiza también la sección 7.6 de app/legal/plantillas/terminos.html.
REPORT_EXPIRY_DAYS=90
# Al publicar un reporte se avisa a usuarios con alertas activadas dentro de este radio (km),
# y a refugios y casas de paso aprobados dentro del segundo radio. Los textos legales dicen
# 5 km / 15 km / 5 alertas al día: si los cambias, actualiza las plantillas legales.
NEARBY_ALERT_RADIUS_KM=5
NEARBY_ALERT_PARTNER_RADIUS_KM=15
NEARBY_ALERT_MAX_RECIPIENTS=200
NEARBY_ALERT_DAILY_CAP=5

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) - bot de reportes y avisos
# ---------------------------------------------------------------------------
# Dónde obtenerlo: https://developers.facebook.com/apps  > tu app > WhatsApp > Configuración de la API
#   - WHATSAPP_PHONE_NUMBER_ID: "Identificador del número de teléfono".
#   - WHATSAPP_ACCESS_TOKEN: token permanente de un Usuario del sistema
#     (business.facebook.com > Configuración > Usuarios del sistema > Generar token con permisos
#     whatsapp_business_messaging y whatsapp_business_management).
#   - WHATSAPP_APP_SECRET: Configuración de la app > Básica > "Clave secreta de la app"
#     (valida la firma X-Hub-Signature-256 de cada webhook).
#   - Webhook: URL https://DOMAIN/whatsapp/webhook, token = WHATSAPP_VERIFY_TOKEN,
#     suscríbete al campo "messages".
# [OBLIGATORIA EN PRODUCCIÓN si hay WHATSAPP_ACCESS_TOKEN] un token propio y largo
# (python3 -c "import secrets; print(secrets.token_urlsafe(32))"). Vacío en desarrollo = token de pruebas.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# [OBLIGATORIA EN PRODUCCIÓN si hay WHATSAPP_ACCESS_TOKEN]
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0
# Plantillas aprobadas por Meta (categoría UTILITY) para avisar fuera de la ventana de 24 h.
# Nombre EXACTO de la plantilla en WhatsApp Manager; vacío = ese aviso no se manda por WhatsApp
# (solo en la app y por correo). Textos propuestos en README-despliegue.md.
#   MATCH : "posible coincidencia" para el dueño de un reporte
#   NEARBY: alerta de perrito perdido/encontrado cerca
WHATSAPP_TEMPLATE_MATCH=
WHATSAPP_TEMPLATE_NEARBY=
# Idioma con el que se aprobaron las plantillas
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# ---------------------------------------------------------------------------
# Facebook Pages (ingesta de publicaciones de Páginas, NO grupos)
# ---------------------------------------------------------------------------
# Meta retiró la API de Grupos en 2024 y el scraping de grupos viola sus términos.
# Solo se leen Páginas de Facebook que administres o que te den acceso:
#   https://developers.facebook.com/tools/explorer  > selecciona la Página >
#   permisos pages_read_engagement, pages_read_user_content > genera un
#   Page Access Token de larga duración.
# Las publicaciones de grupos se pueden importar manualmente desde el panel admin.
FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GROUPS= (obsoleta: se acepta por compatibilidad y no hace nada)

# ---------------------------------------------------------------------------
# Grupos públicos de Facebook por estado (proveedor externo: Apify)
# ---------------------------------------------------------------------------
# Los grupos públicos se leen con el actor "Facebook Groups Scraper" de Apify (un servicio de pago):
# GuauWoow no entra a Facebook. Los admins dan de alta los grupos por estado en el panel
# (ver docs/facebook-grupos.md) y las publicaciones con perritos perdidos/encontrados se vuelven
# reportes con fuente "facebook" (sin teléfonos, correos ni @usuarios: se quitan antes de guardar).
# Interruptor legal de la importación automática (grupos y Páginas). Apagado por defecto: aunque haya
# APIFY_TOKEN no se importa nada. En producción, true exige FB_GROUPS_LEGAL_OPINION_REF (la referencia de la
# opinión legal escrita que autoriza importar publicaciones públicas; contenido-importado.html).
FB_GROUPS_ENABLED=false
FB_GROUPS_LEGAL_OPINION_REF=
# Dónde obtenerlo: https://console.apify.com/settings/integrations > Personal API tokens.
# Vacío = proveedor no configurado: las tareas no hacen nada y el panel lo indica.
APIFY_TOKEN=
# [avanzada] Actor de Apify ("usuario/nombre"). Precio (oct. 2026, plan gratuito): ~0.005 USD por
# publicación + 0.002 USD extra por publicación cuando se filtra por fecha (siempre, aquí) y
# ~0.001-0.006 USD por arranque. Planes de pago bajan a ~0.0026-0.004 USD por publicación.
APIFY_FB_GROUPS_ACTOR=apify/facebook-groups-scraper
# Cada grupo se vuelve a leer como máximo cada estas horas (también cuando un reporte nuevo de
# su estado dispara la lectura); en la primera lectura se piden publicaciones de LOOKBACK días.
FB_GROUPS_FETCH_INTERVAL_HOURS=12
FB_GROUPS_LOOKBACK_DAYS=14
# Publicaciones máximas por grupo y corrida; presupuesto diario (USD, día UTC) y precio estimado
# por cada 1000 publicaciones y por arranque con el que se aparta el gasto (ajústalo a tu plan de
# Apify). El gasto real de cada corrida (usageTotalUsd de Apify) corrige la estimación al terminar.
FB_GROUPS_MAX_POSTS_PER_RUN=100
FB_GROUPS_DAILY_BUDGET_USD=2.0
FB_GROUPS_COST_PER_1000_POSTS_USD=7.0
FB_GROUPS_COST_PER_RUN_USD=0.005
# Días que un reporte importado de un grupo sigue visible (contados desde la fecha de la publicación
# original); después pasa a "expirado" y deja de ser público. FB_VOLUNTEER_POST_TTL_DAYS aplica lo
# mismo a los envíos de voluntarios (aviso de privacidad: 30 días para ambos).
FB_GROUPS_POST_TTL_DAYS=30
FB_VOLUNTEER_POST_TTL_DAYS=30
# Días después de expirar en que se borran el texto y las fotos del reporte importado (0 = el mismo día;
# la página /legal/contenido-importado promete el borrado a los 30 días)
FB_IMPORTED_PURGE_AFTER_DAYS=0

# ---------------------------------------------------------------------------
# Veterinarias: reseñas de Google Maps (Places API New)
# ---------------------------------------------------------------------------
# Llave de servidor de Google Maps Platform con "Places API (New)" habilitada y restringida por IP
# del servidor y por API (https://console.cloud.google.com/google/maps-apis/credentials).
# Dónde obtenerla: crea un proyecto con cuenta de facturación > APIs y servicios > Biblioteca > habilita
#   "Places API (New)" (no la "Places API" heredada) > Credenciales > Crear llave de API. Restricciones:
#   de aplicación "Direcciones IP" (la IP pública del servidor) y de API solo "Places API (New)".
#   Configura cuotas por día y una alerta de presupuesto en Facturación.
# Las consultas se hacen desde el backend: el navegador nunca habla con Google.
# Vacía = el perfil de cada clínica se muestra sin el bloque "Reseñas en Google Maps" y la búsqueda
# de la ficha responde 503 con un mensaje claro. Solo se guarda el place_id: las reseñas y la
# calificación se piden en cada vista del perfil (las políticas de Google prohíben guardarlas).
# BLOQUEANTE DE LANZAMIENTO: no la llenes en producción hasta publicar (python3 scripts/render-legal.py)
# los Términos y el Aviso de Privacidad con la cláusula de Google Maps (sección 9.3 de la plantilla) y
# la página /app/legal/veterinarias.html: las políticas de Places exigen Términos y Aviso públicos que
# incorporen los términos de Google. Además del tope diario hay un límite por cuenta e IP por hora.
GOOGLE_MAPS_API_KEY=
# Tope diario de vistas de perfil que consultan reseñas a Google (Place Details con reviews se
# cobra en el SKU "Enterprise + Atmosphere"). Al llegar al tope el perfil se muestra sin el bloque
# de Google (con el enlace a Google Maps) hasta el día siguiente. 0 = nunca consultar reseñas.
GOOGLE_PLACES_DAILY_LIMIT=200
# Antigüedad mínima (días) de la cuenta para reseñar una clínica en GuauWoow. 0 = sin mínimo;
# la política de reseñas propone 7 (decisión del dueño).
VETERINARY_REVIEW_MIN_ACCOUNT_DAYS=0

# ---------------------------------------------------------------------------
# Moderación legal: reportes públicos, evidencia, derechos de autor y autoridades
# ---------------------------------------------------------------------------
# Contacto 24/7 para autoridades (Decreto NNA art. 5 fr. I). Debe coincidir con CONTACTO_24_7_PARA_AUTORIDADES
# de datos-legales.json (autoridades.html). Lo devuelve GET /cumplimiento/autoridades/contacto.
AUTHORITY_CONTACT_EMAIL=
AUTHORITY_CONTACT_PHONE=
# Primera respuesta a una autoridad: minutos si hay menores o riesgo para la vida; horas en los demás casos
# (PLAZO_DE_PRIMERA_RESPUESTA_A_AUTORIDADES).
AUTHORITY_FIRST_RESPONSE_URGENT_MINUTES=60
AUTHORITY_FIRST_RESPONSE_HOURS=24
# Plazos objetivo de la cola de moderación: urgentes en horas (PLAZO_OBJETIVO_DE_REPORTES_URGENTES), respuesta
# a reportes sobre menores en horas (PLAZO_DE_RESPUESTA_A_REPORTES_SOBRE_MENORES) y el resto en días hábiles
# (PLAZO_OBJETIVO_DE_REVISION_DE_REPORTES: 72 horas hábiles = 3).
MODERATION_URGENT_HOURS=24
MODERATION_MINOR_RESPONSE_HOURS=72
MODERATION_REVIEW_BUSINESS_DAYS=3
# Apelaciones: días naturales para apelar desde el aviso (PLAZO_PARA_APELAR) y días hábiles para resolver
# (PLAZO_PARA_RESOLVER_APELACIONES).
APPEAL_WINDOW_DAYS=15
APPEAL_RESOLUTION_BUSINESS_DAYS=10
# Derechos de autor: plazo objetivo de retiro en días hábiles (PLAZO_OBJETIVO_DE_RETIRO_POR_DERECHOS_DE_AUTOR) y
# política de reincidentes (derechos-de-autor.html §8): avisos procedentes en 12 meses que suspenden la cuenta,
# los que la cancelan y los días de suspensión.
COPYRIGHT_REMOVAL_BUSINESS_DAYS=1
COPYRIGHT_STRIKES_SUSPEND=2
COPYRIGHT_STRIKES_CANCEL=3
COPYRIGHT_SUSPENSION_DAYS=30
# Bóveda de evidencia (copias cifradas de lo retirado): días hábiles mínimos de conservación (Decreto NNA art. 5
# fr. II) y carpeta. Vacía = <UPLOAD_DIR>/private/evidencia, que Nginx y el backend nunca sirven.
EVIDENCE_RETENTION_BUSINESS_DAYS=90
EVIDENCE_DIR=
# Formularios públicos sin cuenta (reportes, avisos de derechos de autor, contra-avisos y apelaciones): por IP y hora
PUBLIC_REPORTS_HOURLY_LIMIT=5

# ---------------------------------------------------------------------------
# Centro de solicitudes (derechos ARCO, quejas, retiro de importados) e informe de transparencia
# ---------------------------------------------------------------------------
# Quejas y aclaraciones (atencion-y-quejas.html): primera respuesta y respuesta final, en días hábiles.
# Deben coincidir con PLAZO_DE_PRIMERA_RESPUESTA y PLAZO_DE_RESPUESTA_A_QUEJAS de datos-legales.json.
# Los plazos ARCO (20 días hábiles para responder y 15 para hacerla efectiva) los fija la LFPDPPP.
COMPLAINT_FIRST_RESPONSE_BUSINESS_DAYS=2
COMPLAINT_RESPONSE_BUSINESS_DAYS=10
# Horas después de pedir el retiro de una publicación importada en que se borran su texto y fotos (si el
# equipo no lo descarta antes). La publicación se oculta al momento; la página promete menos de 72 h.
IMPORTED_REMOVAL_PURGE_HOURS=48
# Regla de umbral del informe de transparencia: no se publican desgloses con menos casos que este número.
TRANSPARENCY_MIN_CASES=5

# ---------------------------------------------------------------------------
# Legal: versión vigente de Términos y Aviso de Privacidad (se guarda al aceptar)
# ---------------------------------------------------------------------------
# DÉJALAS VACÍAS: el valor por defecto de backend/app/config.py coincide con la versión impresa en
# app/legal/plantillas/*.html (scripts/render-legal.py --check lo verifica). Al publicar una versión
# nueva de los textos, cambia la fecha en la plantilla Y en config.py.
LEGAL_TERMS_VERSION=
LEGAL_PRIVACY_VERSION=
# Registro de versiones de los documentos legales (K-DOCS). Vacío => app/data/versiones-legales.json dentro de la
# imagen (copia que deja scripts/render-legal.py) y, fuera de Docker, ../app/legal/versiones.json.
# Se carga con: python -m app.cli sync-legal-docs (lo corre deploy.sh; el backend también lo hace al arrancar).
LEGAL_VERSIONS_FILE=
# Casilla separada del anexo de aliados (Refugios, vendedores, clínicas, casas de paso) obligatoria al registrarse
# o al publicar el primer producto. Vacío => obligatoria solo en production.
LEGAL_ANNEX_REQUIRED=
# Días mínimos de aviso previo de un cambio importante (historial.html §2). El sync advierte si es menor.
LEGAL_NOTICE_DAYS=30

# ---------------------------------------------------------------------------
# Observabilidad (todo opcional; vacío = desactivado)
# ---------------------------------------------------------------------------
# Sentry (backend FastAPI + Celery): https://sentry.io > Settings > Projects > Client Keys (DSN)
# No envía datos personales: se filtran Authorization, cookies, teléfonos y correos.
SENTRY_DSN=
# Entorno que se ve en Sentry. Vacío = ENVIRONMENT (docker-compose.production.yml pone production).
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
# DSN del proyecto de navegador (el frontend lo lee de /auth/config). No actives Session Replay
# (el Aviso de Privacidad dice que no se graban sesiones).
SENTRY_DSN_FRONTEND=
# PostHog (analítica del frontend; solo con consentimiento del banner): https://posthog.com
#   Project settings > Project API key. Activa "Discard client IP data".
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Respaldos (docker-compose.production.yml: servicios backup y backup-offsite)
# ---------------------------------------------------------------------------
# [OBLIGATORIA EN PRODUCCIÓN] Cifra los respaldos (AES-256 en el servidor y rclone crypt en la copia
# externa). Guárdala FUERA del servidor (gestor de contraseñas): sin ella NO se pueden restaurar.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_ENCRYPTION_PASSWORD=
# Segunda contraseña (sal) de rclone crypt para la copia externa. Opcional pero recomendada;
# guárdala junto con la anterior. No la cambies después del primer respaldo externo.
BACKUP_ENCRYPTION_SALT=
# Diario: pg_dump cifrado + instantánea incremental de las fotos en ./backups; se conservan
# BACKUP_RETENTION_DAYS días. Corre una vez al día a partir de la hora local BACKUP_HOUR (0-23, TZ del
# contenedor = hora del centro de México). Ojo: BACKUP_HOUR VACÍA no equivale a 3, significa "cada
# BACKUP_INTERVAL_SECONDS desde el último respaldo"; por eso va comentada.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# BACKUP_HOUR=3
# Aviso de "respaldo hecho / falló" (estilo healthchecks.io: se llama a la URL, /start y /fail).
# Crea un check en https://healthchecks.io (gratis) con periodo de 1 día y gracia de 2 h.
BACKUP_HEARTBEAT_URL=
#
# Copia externa cifrada a S3 o Cloudflare R2 (vacío = desactivada; muy recomendada).
#   R2: Cloudflare > R2 > crea el bucket > Manage API tokens (Object Read & Write, solo ese bucket) ->
#       BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, BACKUP_S3_PROVIDER=Cloudflare
#   AWS S3: BACKUP_S3_PROVIDER=AWS, BACKUP_S3_REGION=us-east-1, BACKUP_S3_ENDPOINT vacío
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=patitasfind
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Días que se conservan en el bucket los archivos borrados o reemplazados
BACKUP_OFFSITE_RETENTION_DAYS=30
# Hora local a la que se sube la copia externa (después del respaldo diario). Vacía = cada
# BACKUP_INTERVAL_SECONDS desde la última corrida; por eso va comentada.
# BACKUP_OFFSITE_HOUR=4
# Igual que BACKUP_HEARTBEAT_URL, para la copia externa (otro check)
BACKUP_OFFSITE_HEARTBEAT_URL=

# ---------------------------------------------------------------------------
# Monitoreo del disco (servicio backup)
# ---------------------------------------------------------------------------
# Check de healthchecks.io (periodo 1 h, gracia 1 h): se le hace ping cada hora si el disco está bien
# y <URL>/fail con el detalle cuando alguna ruta pasa DISK_ALERT_THRESHOLD %; si el servidor deja de
# reportar, healthchecks también te avisa. Vacío = solo se registra en los logs.
DISK_ALERT_URL=
DISK_ALERT_THRESHOLD=85
DISK_CHECK_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Solo desarrollo: datos de prueba (backend/seed_data.py; nunca corre en producción)
# ---------------------------------------------------------------------------
# Contraseña de los usuarios @patitas.com. Vacía = se genera una al azar y se imprime.
# El contenedor no la recibe del .env: pásala al ejecutar, p. ej.
#   docker compose exec -e SEED_PASSWORD=Patitas123! backend python seed_data.py --reset
SEED_PASSWORD=
