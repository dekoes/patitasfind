# =============================================================================
# PatitasFind - Variables de entorno
# =============================================================================
# Copia este archivo a .env (en la raíz del repo) y completa los valores.
#   cp .env.example .env
# Docker Compose lo lee automáticamente. Cada integración externa es OPCIONAL:
# si su variable está vacía, la función se desactiva con un mensaje claro (503)
# o, solo en ENVIRONMENT=development, usa una alternativa de prueba documentada.

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
# development | production
#  - development: login demo activo, OTP/pagos/correos simulados si faltan llaves.
#  - production: sin simulaciones (503 cuando falta una integración) y se NIEGA a arrancar si:
#    SECRET_KEY es la de desarrollo, CORS_ORIGINS está vacío, la contraseña de Postgres es
#    "patitasfind", CORS_ORIGIN_REGEX permite trycloudflare, SMS_PROVIDER=dev o sin llaves, o WhatsApp está
#    activo sin WHATSAPP_APP_SECRET / con el WHATSAPP_VERIFY_TOKEN de desarrollo.
ENVIRONMENT=development

# Dominio público SIN https:// (producción: Nginx, certificados y valores por defecto de
# PUBLIC_BASE_URL y CORS_ORIGINS en docker-compose.production.yml)
DOMAIN=patitasfind.mx
# Modo de Nginx en producción: https (normal) | http-only (solo para emitir el primer certificado)
NGINX_MODE=https

# URL pública desde la que la gente abre PatitasFind, SIN "/" al final.
# Se usa para: enlaces de "restablecer contraseña", back_urls y webhook de
# Mercado Pago, redirección de Google y links que manda el bot de WhatsApp.
# Ejemplos: https://patitasfind.mx  |  https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=http://localhost:8082

# Login de demostración (botón "Entrar sin cuenta"). Vacío = activo solo en development.
# En production siempre está desactivado.
ALLOW_DEMO_LOGIN=

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://patitasfind:patitasfind@postgres:5432/patitasfind
POSTGRES_USER=patitasfind
# En producción usa una contraseña larga SIN caracteres especiales de URL (@ : / ?), p. ej.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (docker-compose.production.yml arma DATABASE_URL con ella)
POSTGRES_PASSWORD=patitasfind
POSTGRES_DB=patitasfind
# Puerto del host para PostgreSQL en desarrollo (docker-compose.yml)
POSTGRES_HOST_PORT=5433

# ---------------------------------------------------------------------------
# Seguridad / sesiones (JWT)
# ---------------------------------------------------------------------------
# OBLIGATORIA en producción. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
# Duración de la sesión en minutos (10080 = 7 días)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# CORS (orígenes que pueden llamar a la API desde el navegador)
# ---------------------------------------------------------------------------
# Lista separada por comas. OBLIGATORIA en producción (p. ej. https://patitasfind.mx);
# en development, si se deja vacía, se permiten los puertos locales habituales.
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
# Regex adicional. Vacío = en development permite túneles *.trycloudflare.com; en production ninguno.
CORS_ORIGIN_REGEX=

# ---------------------------------------------------------------------------
# Archivos subidos
# ---------------------------------------------------------------------------
# Carpeta relativa al directorio del backend (en Docker: /app/uploads)
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Redis (Celery, chat en tiempo real entre workers, caché, rate limit)
# ---------------------------------------------------------------------------
# Con REDIS_URL las tareas pesadas van a Celery y el chat funciona con varios workers.
# Sin REDIS_URL todo corre dentro del proceso (BackgroundTasks de FastAPI).
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# IA de visión: análisis de fotos (API compatible con OpenAI Chat Completions)
# ---------------------------------------------------------------------------
# Sin AI_API_KEY: la búsqueda por foto funciona solo con similitud visual (hash + color)
# y POST /ai/analyze-photo responde 503 "IA no configurada".
# El backend envía la foto (máx. 1024 px, JPEG) como data URI y pide "responde SOLO con JSON";
# no depende de response_format. Timeout 20 s, 1 reintento en 429/5xx.
AI_PROVIDER=openai_compatible
AI_API_KEY=
#
# Opción A (por defecto) – Alibaba Cloud Model Studio internacional (Qwen3-VL):
#   Llave: https://modelstudio.console.alibabacloud.com  > API Key (región Singapur/internacional)
#   qwen3-vl-flash : el más barato, suficiente para describir perros.
#   qwen3-vl-plus  : mejor calidad (~$0.20 entrada / $1.60 salida USD por millón de tokens).
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3-vl-flash
#
# Opción B – Z.ai (GLM-4.6V):  https://z.ai/manage-apikey/apikey-list
#   AI_BASE_URL=https://api.z.ai/api/paas/v4
#   AI_MODEL=glm-4.6v-flash   (gratis, con límite de peticiones)  |  glm-4.6v  (de pago, mejor)
#
# JSON opcional que se agrega al cuerpo de la petición (parámetros propios del proveedor), p. ej.
#   Qwen3 sin razonamiento:  AI_EXTRA_BODY={"enable_thinking": false}
#   GLM sin razonamiento:    AI_EXTRA_BODY={"thinking": {"type": "disabled"}}
AI_EXTRA_BODY=
# Puntaje mínimo (0-100) para avisar "¡Posible coincidencia!" a los dueños de reportes
MATCH_SCORE_THRESHOLD=60

# ---------------------------------------------------------------------------
# Pagos: Mercado Pago Checkout Pro (México, MXN)
# ---------------------------------------------------------------------------
# Dónde obtenerlo: https://www.mercadopago.com.mx/developers/panel/app
#   Crea una aplicación > "Credenciales de producción" (o de prueba) > Access Token.
# Webhook: en la app de Mercado Pago > Webhooks, configura
#   URL: {PUBLIC_BASE_URL}/payments/mercadopago/webhook   Evento: Pagos
#   y copia la "Clave secreta" en MERCADOPAGO_WEBHOOK_SECRET (valida x-signature).
# Sin token: en development los pedidos/donaciones se aprueban de forma simulada;
# en production responden 503.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Verificación de teléfono por SMS (obligatoria para publicar, adoptar, chatear, pagar…)
# ---------------------------------------------------------------------------
# PatitasFind genera su propio código de 6 dígitos (vence en 10 min, 5 intentos, reenvío cada
# 60 s, máx. 5 SMS por teléfono y 10 por IP cada hora). El proveedor solo entrega el SMS.
#   smsmasivos (recomendado en México, ~$0.47–0.90 MXN por SMS) | twilio | dev
#   dev: no envía nada y devuelve el código como "dev_code" (solo ENVIRONMENT=development).
#   En development, si el proveedor elegido no tiene llaves, se usa "dev" automáticamente.
SMS_PROVIDER=smsmasivos
# false = el teléfono es opcional y no se exige verificarlo
REQUIRE_PHONE_VERIFICATION=true
#
# SMS Masivos: https://app.smsmasivos.com.mx  > API > copia tu API key
SMSMASIVOS_API_KEY=
# 1 = modo sandbox (la API responde OK sin enviar ni cobrar; útil para probar la integración)
SMSMASIVOS_SANDBOX=false
#
# Twilio (Messages API; NO Verify): https://console.twilio.com
#   Account SID y Auth Token en la consola; un número con SMS habilitado para México
#   o un Messaging Service (MG...). Más caro (~$0.18 USD por SMS a México).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------
# Legal: versión vigente de Términos y Aviso de Privacidad (se guarda al aceptar)
# ---------------------------------------------------------------------------
LEGAL_TERMS_VERSION=2026-10-04
LEGAL_PRIVACY_VERSION=2026-10-04

# ---------------------------------------------------------------------------
# Correo (SMTP) para "olvidé mi contraseña"
# ---------------------------------------------------------------------------
# Cualquier proveedor SMTP: Gmail/Google Workspace (contraseña de aplicación),
# Amazon SES, SendGrid, Mailgun, Zoho, etc. Puerto 587 = STARTTLS, 465 = SSL.
# Sin SMTP: el enlace se imprime en los logs del backend (y en development
# también se devuelve como "dev_link" en la respuesta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PatitasFind <no-reply@patitasfind.mx>

# ---------------------------------------------------------------------------
# Google OAuth (botón "Continuar con Google")
# ---------------------------------------------------------------------------
# Dónde obtenerlo: https://console.cloud.google.com/apis/credentials
#   Crear credenciales > ID de cliente de OAuth > Aplicación web.
#   Pasos completos en README-despliegue.md ("Google OAuth").
#   URI de redireccionamiento: {PUBLIC_BASE_URL}/auth/google/callback
#   (local: http://localhost:8082/auth/google/callback, pasa por app/server.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: forzar otra URI; vacío = {PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) - bot de reportes
# ---------------------------------------------------------------------------
# Dónde obtenerlo: https://developers.facebook.com/apps  > tu app > WhatsApp > Configuración de la API
#   - WHATSAPP_PHONE_NUMBER_ID: "Identificador del número de teléfono".
#   - WHATSAPP_ACCESS_TOKEN: token permanente de un Usuario del sistema
#     (Business Manager > Usuarios del sistema > Generar token con permisos
#     whatsapp_business_messaging y whatsapp_business_management).
#   - WHATSAPP_APP_SECRET: Configuración de la app > Básica > "Clave secreta de la app"
#     (valida la firma X-Hub-Signature-256 de cada webhook).
#   - Webhook: URL {PUBLIC_BASE_URL}/whatsapp/webhook, token = WHATSAPP_VERIFY_TOKEN,
#     suscríbete al campo "messages".
WHATSAPP_VERIFY_TOKEN=patitasfind-dev-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Facebook Pages (ingesta de publicaciones de Páginas, NO grupos)
# ---------------------------------------------------------------------------
# Meta retiró la API de Grupos en 2024 y el scraping de grupos viola sus términos.
# Solo se leen Páginas de Facebook que administres o que te den acceso:
#   https://developers.facebook.com/tools/explorer  > selecciona la Página >
#   permisos pages_read_engagement, pages_read_user_content > genera un
#   Page Access Token de larga duración.
# Las publicaciones de grupos se pueden importar manualmente desde el panel admin.
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Observabilidad (todo opcional; vacío = desactivado)
# ---------------------------------------------------------------------------
# Sentry (backend FastAPI + Celery): https://sentry.io > Settings > Projects > Client Keys (DSN)
# No envía datos personales: se filtran Authorization, cookies, teléfonos y correos.
SENTRY_DSN=
# Por defecto = ENVIRONMENT
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
# DSN del proyecto de navegador (el frontend lo lee de /auth/config)
SENTRY_DSN_FRONTEND=
# PostHog (analítica del frontend; se activa solo con consentimiento): https://posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Respaldos (docker-compose.production.yml: servicios backup y backup-offsite)
# ---------------------------------------------------------------------------
# Diario: pg_dump -Fc + tar.gz de uploads en ./backups, se conservan N días.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# Copia externa opcional a S3 o Cloudflare R2 (vacío = desactivada).
#   R2: Cloudflare > R2 > Manage API tokens (Object Read & Write) ->
#       BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, BACKUP_S3_PROVIDER=Cloudflare
#   AWS S3: BACKUP_S3_PROVIDER=AWS, BACKUP_S3_REGION=us-east-1, BACKUP_S3_ENDPOINT vacío
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=patitasfind
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
